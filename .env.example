APP_NAME=V2Board
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# 日志通道：mysql（写入 v2_log，后台系统日志页依赖）或 stack（文件）
LOG_CHANNEL=mysql

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=123456

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAILGUN_DOMAIN=
MAILGUN_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 注意：本项目配置读取的是 AWS_V2BOARD_REGION（非 AWS_DEFAULT_REGION）
AWS_V2BOARD_REGION=us-east-1
AWS_BUCKET=

# 反向代理可信列表（TrustProxies），如 127.0.0.1 或 *；无代理时留空
TRUSTED_PROXIES=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
