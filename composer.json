{
    "name": "v2board/v2board",
    "type": "project",
    "description": "v2board is a proxy protocol manage.",
    "keywords": [
        "v2board",
        "v2ray",
        "shadowsocks",
        "trojan",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.0",
        "google/recaptcha": "^1.5",
        "guzzlehttp/guzzle": "^7.4.3",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.21",
        "laravel/tinker": "^3.0",
        "paragonie/sodium_compat": "^2.0",
        "php-curl-class/php-curl-class": "^13.0",
        "rybakit/msgpack": "^0.10.0",
        "stripe/stripe-php": "^20.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Library\\": "library/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://packagist.org"
        }
    }
}